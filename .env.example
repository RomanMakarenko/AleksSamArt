# ── Google (OAuth + Drive) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET вводить користувач у Google Cloud Console.
# Для npm run setup:google додайте redirect URI http://localhost:8787 в OAuth client
# (або задайте GOOGLE_REDIRECT_URI, якщо зареєстрували інший порт).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN генерується автоматично: npm run setup:google (етап 2)
GOOGLE_REFRESH_TOKEN=
# ID кореневої папки з роботами в Google Drive
GOOGLE_DRIVE_FOLDER_ID=

# ── Замовлення (Netlify Forms) ─────────────────────────────────────────
# Email, на який приходять замовлення
CONTACT_EMAIL=

# ── Соцмережі ───────────────────────────────────────────────────────────
FACEBOOK_URL=
INSTAGRAM_URL=

# ── Валюта цін (дефолт USD = умовні одиниці) ─────────────────────────────
CURRENCY=USD