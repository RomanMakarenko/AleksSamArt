---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DICTIONARIES, type Locale } from '../i18n';
import { SITE } from '../config/site';
import { Image } from 'astro:assets';
import frameImage from '../assets/works/ORDER-Girl with a baby/photo-frame.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = DICTIONARIES[lang];
---

<BaseLayout lang={lang} title={`${t.frameInfo.title} · ${SITE.title}`} description={t.frameInfo.description}>
  <main class="frame-info">
    <div class="frame-info__content">
      <a class="frame-info__back" href={lang === 'uk' ? '/' : `/${lang}/`}>
        ← {t.frameInfo.backToGallery}
      </a>
      <h1 class="frame-info__title">{t.frameInfo.title}</h1>
      <div class="frame-info__frame">
        <Image src={frameImage} alt={t.frameInfo.imageAlt} sizes="(max-width: 700px) 92vw, 780px" />
      </div>
      <p class="frame-info__description">{t.frameInfo.description}</p>
    </div>
  </main>
</BaseLayout>
