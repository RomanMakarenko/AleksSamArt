---
/**
 * Модальна форма «Замовити»/«Купити» (етап 5).
 *
 * Рендериться один раз на сторінці (у `Home.astro`). Два потоки:
 *  - **«Замовити»** — вибір формату та кількості людей (ціна з `src/config`);
 *    обов'язкове фото — потрібне для замовлення та точної ціни.
 *  - **«Купити»** — купівля готової роботи: ціна з `ARTWORK_PRICES` або
 *    стандартна ціна 50 EUR, без вибору розміру та завантаження фото.
 *
 * Відкривається кнопками `[data-order-button]` / `[data-buy-button]` у WorkCard
 * (назва роботи — з `data-work-name` картки, фіксована ціна «Купити» — з
 * `data-portrait-price` модального вікна). Надсилання — через **Netlify Forms**:
 * розмітка `<form name="order" data-netlify="true">` присутня в статичному HTML
 * (Netlify виявляє форми на build), а клієнт надсилає її через fetch (AJAX)
 * з усіма полями, включно з фото.
 *
 * Тексти, що змінюються залежно від потоку/стану, передаються в клієнтський
 * скрипт через `data-*` атрибути (як `data-counter-format` у лайтбоксі).
 * Клієнтська логіка — `src/lib/order-form.ts` (підключена внизу).
 */
import type { Dictionary, Locale } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ARTWORK_CURRENCY, ORDER_PRICES, ORDER_SIZES, CUSTOM_SIZE_ID } from '../config/site';

interface Props {
  t: Dictionary;
  lang: Locale;
}

const { t, lang } = Astro.props;

// За замовчуванням вибраний перший розмір зі списку (A4).
const defaultSizeId = ORDER_SIZES[0]?.id ?? '';
const currencyByRegion = { ua: 'UAH', international: 'EUR' } as const;
---

<div
  class="order-modal"
  data-order-modal
  aria-hidden="true"
  data-currency-ua={currencyByRegion.ua}
  data-currency-international={currencyByRegion.international}
  data-artwork-currency={ARTWORK_CURRENCY}
  data-order-title={t.form.orderTitle}
  data-buy-title={t.form.buyTitle}
  data-submit-order={t.form.submitOrder}
  data-buy-with-price={t.form.buyWithPrice}
  data-success={t.form.success}
  data-error={t.form.error}
  data-required={t.form.required}
  data-email-invalid={t.form.emailInvalid}
  data-negotiable={t.form.negotiablePrice}
  data-artwork-format={t.form.artworkFormat}
  data-pricing-region="international"
>
  <div class="order-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="order-modal-title">
    <!-- Кнопка закриття — на ній фокус після відкриття. -->
    <button
      type="button"
      class="order-modal__close"
      data-order-close
      aria-label={t.lightbox.close}
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <!-- Підтвердження успіху — замінює форму після надсилання. -->
    <div class="order-modal__success" data-order-success hidden>
      <p class="order-modal__success-icon" aria-hidden="true">✓</p>
      <p class="order-modal__success-text" data-order-success-text></p>
    </div>

    <!--
      Netlify Forms: форма нижче — статична розмітка, яку Netlify знаходить на build
      (атрибут data-netlify + name="order"). AJAX-надсилання робить `order-form.ts`
      (приховані поля work/mode/price заповнюються клієнтом перед сабмітом).
    -->
    <form
      class="order-form"
      name="order"
      method="POST"
      data-netlify="true"
      data-order-form
      novalidate
    >
      <input type="hidden" name="form-name" value="order" />
      <input type="hidden" name="mode" data-order-mode />
      <input type="hidden" name="work" data-order-work />
      <input type="hidden" name="price" data-order-price />
      <input type="hidden" name="currency" data-order-currency />
      <input type="hidden" name="pricing-region" data-order-region />

      <h2 class="order-modal__title" id="order-modal-title" data-order-title-text></h2>

      <label class="order-form__field">
        <span class="order-form__label">{t.form.name}</span>
        <input class="order-form__input" type="text" name="name" autocomplete="name" required />
      </label>

      <label class="order-form__field">
        <span class="order-form__label">{t.form.email}</span>
        <input class="order-form__input" type="email" name="email" autocomplete="email" required />
      </label>

      <!-- Розмір → ціна автоматично. «Свій розмір» — ціна договірна. -->
      <fieldset class="order-form__sizes" data-order-sizes>
        <legend class="order-form__label">{t.form.size}</legend>
        <div class="order-form__size-grid">
          {ORDER_SIZES.map((size) => (
            <label class="order-form__size">
              <input
                type="radio"
                name="size"
                value={size.id}
                data-price-ua={ORDER_PRICES.ua[size.id]}
                data-price-international={ORDER_PRICES.international[size.id]}
                checked={size.id === defaultSizeId}
              />
              <span class="order-form__size-label">
                {size.label}
                <span class="order-form__people-count" title={t.form.peopleHint.replace('{count}', String(size.people))}>
                  ({size.people})
                </span>
              </span>
              <span class="order-form__size-price" data-size-price-value>
                {ORDER_PRICES.international[size.id]} EUR
              </span>
            </label>
          ))}
          <p class="order-form__people-legend">{t.form.peopleLegend}</p>
          <label class="order-form__size">
            <input type="radio" name="size" value={CUSTOM_SIZE_ID} data-size-custom />
            <span class="order-form__size-label">{t.form.customSize}</span>
            <span class="order-form__size-price">{t.form.negotiablePrice}</span>
          </label>
        </div>
      </fieldset>

      <div class="order-form__price" data-order-price-row>
        <span class="order-form__price-label">{t.form.price}:</span>
        <strong class="order-form__price-value" data-order-price-value></strong>
        <span class="order-form__format" data-order-format></span>
      </div>

      <div class="order-form__notes" role="note">
        <p class="order-form__framing-note">
          <span>{t.form.orderNotes.framing}</span>
          <a
            class="order-form__info-link"
            href={getRelativeLocaleUrl(lang, 'info')}
            aria-label={t.frameInfo.linkLabel}
            title={t.frameInfo.linkLabel}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 10.5v6M12 7.5h.01" />
            </svg>
          </a>
        </p>
        <p data-order-timing>{t.form.orderNotes.timing}</p>
        <p>{t.form.orderNotes.shipping}</p>
      </div>

      <!-- Фото потрібне: для замовлення та точної ціни (свій розмір/портрет). -->
      <div class="order-form__field" data-order-photo>
        <span class="order-form__label" id="order-photo-label">{t.form.photo}</span>
        <input
          class="order-form__input order-form__file"
          type="file"
          name="photo"
          accept="image/*"
          aria-labelledby="order-photo-label"
          data-order-photo-input
        />
        <p class="order-form__hint">{t.form.photoHint}</p>
      </div>

      <label class="order-form__field">
        <span class="order-form__label">{t.form.comment}</span>
        <textarea class="order-form__textarea" name="comment" rows="3"></textarea>
      </label>

      <p class="order-form__error" data-order-error hidden></p>

      <button class="btn btn--order order-form__submit" type="submit" data-order-submit>
        {t.form.submitOrder}
      </button>
    </form>
  </div>
</div>

<script>
  import '../lib/order-form';
</script>