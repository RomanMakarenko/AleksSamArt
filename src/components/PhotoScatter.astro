---
/**
 * Фон стартового екрана — «розсип» головних фото робіт.
 *
 * Колаж із головних зображень робіт (по одному на роботу), розкиданих по
 * екрану з різним нахилом і розміром — ніби фотки лежать на столі. Позиції —
 * статичний масив слотів (детерміновано на build, без JS-розрахунків).
 *
 * Вага: беруться маленькі прев'ю (`Work.thumb`, ~420px), а не повнорозмірні
 * 2048px, щоб не роздувати перший екран. Оверлей затемнює колаж, щоб
 * заголовок лишався читабельним («заглушений» фон замість порожнього темного).
 *
 * Анімація (легке «плавання» + паралакс при скролі) — у `src/lib/gallery.ts`,
 * який читає `[data-scatter]`, `[data-scatter-item]` та `data-rot`.
 */
import { getImage } from 'astro:assets';
import penelopeCruz from '../assets/home/Penelope Cruz-1.jpg';
import type { Work } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;
const { src: penelopeThumb } = await getImage({
  src: penelopeCruz,
  width: 420,
  format: 'webp',
  quality: 80,
});

/**
 * Слоти розкиду: `left`/`top` у % екрана, `width` у vmin, `rot` у градусах.
 * Середина (за заголовком) — розріджена й дрібніша; краї — щільніші.
 * Слот 11 — «майже в центрі»: зсунутий лівіше, щоб не закривати заголовок.
 */
const SLOTS = [
  { left: 5, top: 6, width: 21, rot: -8 },
  { left: 16, top: 20, width: 15, rot: 6 },
  { left: 3, top: 46, width: 17, rot: 10 },
  { left: 11, top: 74, width: 23, rot: -5 },
  { left: 29, top: 84, width: 15, rot: 4 },
  { left: 45, top: 5, width: 17, rot: -3 },
  { left: 52, top: 72, width: 19, rot: -9 },
  { left: 66, top: 16, width: 14, rot: 7 },
  { left: 76, top: 44, width: 21, rot: -6 },
  { left: 70, top: 80, width: 15, rot: 8 },
  { left: 88, top: 8, width: 16, rot: -10 },
  { left: 30, top: 43, width: 13, rot: -2 },
];

/**
 * Точне розкладання колажа: назва папки роботи (як на картці, без префікса
 * `ORDER-`) → слот. Слоти, не згадані тут, лишаються порожніми — вільні
 * позиції НЕ заповнюються іншими роботами; роботи без слота в колаж не
 * потрапляють у стартовий фон.
 *
 * Penelope Cruz займає слот 2, де раніше була Girl with a baby. Elon Musk —
 * на місці Girl (слот 7), Lenny Kravitz — на місці Red-haired girl (слот 9).
 */
const SLOT_FOR: Record<string, number> = {
  'Robbie Williams': 0,
  'Dua Lipa': 1,
  'Zendaya': 3,
  'Valerii Zaluzhnyi': 5,
  'Drew Barrymore': 6,
  'Elon Musk': 7, // місце Girl — права верхня зона
  'Racer': 8,
  'Lenny Kravitz': 9, // місце Red-haired girl — правий нижній край
};

/**
 * Роботи, які на мобільному зсуваються нижче, щоб не закривати перемикач мови
 * (на десктопі позиція зручна, на вузькому екрані — запливає на текст).
 * Зсув — через `top` у media-запиті `global.css` (`[data-scatter-lower]`),
 * тому з анімацією GSAP (transform) не конфліктує.
 */
const LOWER_ON_MOBILE: ReadonlySet<string> = new Set(['Penelope Cruz', 'Racer']);

// Основні роботи беруться з мапи, а Penelope замінює Girl with a baby
// у другому слоті лише в intro-колажі — картка замовлення не змінюється.
const placed: { src: string; slot: number; lower: boolean; dua: boolean }[] = [{
  src: penelopeThumb,
  slot: 2,
  lower: true,
  dua: false,
}];
for (const work of works) {
  if (!work.thumb) continue;
  const slot = SLOT_FOR[work.name];
  if (slot === undefined) continue;
  placed.push({
    src: work.thumb,
    slot,
    lower: LOWER_ON_MOBILE.has(work.name),
    dua: work.name === 'Dua Lipa',
  });
}
---

<div class="scatter" data-scatter aria-hidden="true">
  <div class="scatter__overlay"></div>
  {placed.map(({ src, slot: slotIdx, lower, dua }) => {
    const slot = SLOTS[slotIdx];
    return (
      <img
        class="scatter__item"
        src={src}
        alt=""
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        style={`left:${slot.left}%;top:${slot.top}%;width:${slot.width * 1.2}vmin;transform:rotate(${slot.rot}deg)`}
        data-rot={slot.rot}
        data-scatter-item
        data-scatter-dua={dua ? '' : undefined}
        data-scatter-lower={lower ? '' : undefined}
      />
    );
  })}
</div>
